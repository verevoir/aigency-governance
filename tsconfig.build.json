{
  // The build, kept apart from the typecheck on purpose.
  //
  // `tsconfig.json` includes `tests`, and `tsc` infers its root from whichever
  // files are present — so building with that config would emit `dist/src/...`
  // and `dist/tests/...`, and `bin` would point at a path that does not exist.
  // A sibling project in this rebuild shipped a container that started a file
  // it had never emitted for exactly this reason, and the fix there was the
  // same: state the root rather than let it be inferred from the tree.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
