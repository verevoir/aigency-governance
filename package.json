{
  "name": "@verevoir/aigency-governance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "verify": "npm run typecheck && npm run test && npm run lint",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write ."
  },
  "bin": {
    "aigency-review": "dist/cli/review.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
